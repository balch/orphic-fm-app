<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Android Auto support (debug builds only) is declared via the
      com.google.android.gms.car.application meta-data + automotive_app_desc
      (<uses name="media"/>). Browsing and playback go through the media3
      MediaLibraryService (DjMediaLibraryService in the main manifest, which also
      declares the legacy android.media.browse.MediaBrowserService action: Auto
      discovers media apps by it); search is served by
      MediaLibrarySession.Callback.onSearch / onGetSearchResult.

      MissingIntentFilterForMediaSearch wants a MEDIA_PLAY_FROM_SEARCH activity
      filter; search runs through the library session instead, so it's suppressed.
    -->
    <application tools:ignore="MissingIntentFilterForMediaSearch">
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>

</manifest>
