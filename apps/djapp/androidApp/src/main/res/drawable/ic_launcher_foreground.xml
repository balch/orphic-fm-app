<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vinyl turntable base (vector) -->
    <item android:drawable="@drawable/ic_launcher_turntable" />
    <!-- Orpheus emblem fills the label well, flush against the red accent ring. -->
    <item
        android:width="26dp"
        android:height="26dp"
        android:gravity="center">
        <bitmap
            android:src="@mipmap/orpheus_emblem"
            android:gravity="center" />
    </item>
    <!-- Concentric grooves painted over the emblem so the label looks pressed into the vinyl. -->
    <item android:drawable="@drawable/ic_launcher_grooves" />
</layer-list>
